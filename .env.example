# Copie para .env.local (fora do git) e preencha com os valores do Supabase local (`supabase status`).
# Nunca ponha aqui chave da nuvem nem senha real.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:43321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# só no servidor (lib/supabase/admin.ts)
SUPABASE_SECRET_KEY=
# Chaves e peppers da ADR 0002: só no servidor; em dev, valores fictícios locais. Na Vercel, o CTO cadastra.
ATTA_SAUDE_CHAVE_MESTRA=
ATTA_DOCUMENTOS_CHAVE_MESTRA=
ATTA_REDE_CHAVE_MESTRA=
ATTA_CPF_PEPPER=
ATTA_RNE_PEPPER=
ATTA_SEAL_PRIVATE_KEY=
ATTA_SEAL_KID=
# E-mail (MIG-30): sem nada aqui, o envio usa o simulador. "real" exige as três variáveis seguintes.
ATTA_EMAIL_MODO=simulador
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
ATTA_EMAIL_REMETENTE=
